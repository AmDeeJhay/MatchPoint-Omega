# Copy this file to .env and fill in ONE provider's key.
#   cp .env.example .env
# .env is ignored by git. Never put keys in code or show them on screen.

# Which model provider Omega uses: ASIOne | Anthropic | OpenAI
PROVIDER=ASIOne

# ASI:One key (asi1.ai -> developer -> API keys)
ASIONE_API_KEY=sk-2VSUBZ7ttp_c21dfEWY_PuPWcg90TitSkxiyzt7hEuk

# Claude key (console.anthropic.com -> API Keys). Used when PROVIDER=Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI key. Used when PROVIDER=OpenAI
OPENAI_API_KEY=
